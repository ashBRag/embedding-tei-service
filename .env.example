# Environment Configuration Example
# Copy to .env.<environment> (e.g. .env.development) and fill in real values.
#
# Shared infra values (Postgres, Redis, Kafka/Redpanda, TEI, AWS/LocalStack, ...)
# come from the infra stack's own .env - this file intentionally does NOT
# duplicate them. The var names below match that .env exactly (TEI_PORT);
# docker-compose.yml loads that infra .env alongside this one (infra's
# .env first, then this file, so anything set here wins on conflict).
# Exception:
#  - TEI_HOST: infra's .env has no host var for it - app/core/config.py
#    defaults it to "text-embeddings-inference" (the TEI service's actual
#    name on the shared Docker network) directly.

# Application Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="Embedding Service"
VERSION=1.0.0
DESCRIPTION="An API endpoint between TEI and consuming services: batches text and returns embeddings"

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
# Expected 'iss'/'aud' claims for inbound service-to-service tokens (see app/api/deps.py:require_scopes)
JWT_ISSUER="https://auth.example.com"
JWT_AUDIENCE="service-b"

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# --- TEI (text-embeddings-inference), via libs/ai/embeddings.py ---
# Must match the TEI server's actual --model-id/flags.
# TEI_CLIENT_BATCH_SIZE=32
# TEI_EMBEDDING_DIM=384
# TEI_REQUEST_TIMEOUT_SECONDS=30

# --- Voyage AI (hosted), via libs/ai/embeddings.py ---
# Only registered as an available `provider` in POST /embed if VOYAGE_API_KEY is set.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
VOYAGE_CLIENT_BATCH_SIZE=128
VOYAGE_REQUEST_TIMEOUT_SECONDS=30

# --- POST /api/v1/embed request bounds ---
# EMBED_MAX_TEXTS_PER_REQUEST=1000
# EMBED_MAX_TEXT_CHARS=20000
